# Copy to .env and fill in what you need. Everything is optional for local use.

PORT=3001
# Required in production: a long random string.
JWT_SECRET=
# Sessions: short access tokens renewed silently by a rotating refresh token.
ACCESS_TOKEN_TTL_MINUTES=120
REFRESH_TOKEN_TTL_DAYS=30

# MongoDB is the primary database. Without it, data is kept in server/data/trusttrace_db.json.
# On first connection to an empty cluster, the local JSON data is migrated automatically.
MONGODB_URI=

# Registrar signing key seed (ECDSA P-256). Change it for any real deployment.
REGISTRAR_PRIVATE_SEED=

# --- Staff & recruiter verification ---
# New recruiter and university accounts start as "pending" until a verified
# registrar approves them. They must use a company / university email, or upload
# a staff or corporate ID. Extra domains to treat as academic (comma-separated):
INSTITUTION_EMAIL_DOMAINS=

# --- Developer mode (demo accounts) ---
# Demo accounts are hidden and locked in production. To present with them, tap
# the version label on the sign-in screen 7 times and enter this key, or sign in
# with one of the developer emails below.
DEVELOPER_ACCESS_KEY=
DEVELOPER_EMAILS=
# Set to true to allow demo accounts without a key (default: on outside production).
ENABLE_DEMO_LOGIN=

# --- Single sign-on (leave blank to hide the buttons) ---
# Google: OAuth client IDs from Google Cloud Console. Comma-separate multiple web IDs.
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Apple: Services ID (web) and/or the iOS bundle ID.
APPLE_SERVICE_ID=
APPLE_BUNDLE_ID=
APPLE_REDIRECT_URI=

# --- Certificate scanner ---
# Layout OCR (text positions for title detection and name forensics). On macOS
# the built-in Apple Vision helper is used automatically; elsewhere set one of:
GOOGLE_VISION_API_KEY=
# Set to "fast" if this Mac's accurate Vision model is broken (detected automatically).
TT_VISION_LEVEL=
# Optional: Gemini Vision adds visual checks and acts as a layout fallback.
GEMINI_API_KEY=
# Online event cross-check. Wikipedia + DNS work with no key; add a web search
# key to also look the event up. Set EVENT_CROSSCHECK=off for offline demos.
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
EVENT_CROSSCHECK=
