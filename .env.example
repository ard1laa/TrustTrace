# Copy to .env and fill in what you need. Everything is optional for local use.

PORT=3001
# Required in production: a long random string.
JWT_SECRET=

# MongoDB is the primary database. Without it, data is kept in server/data/trusttrace_db.json.
# On first connection to an empty cluster, the local JSON data is migrated automatically.
MONGODB_URI=

# Registrar signing key seed (ECDSA P-256). Change it for any real deployment.
REGISTRAR_PRIVATE_SEED=

# Code university staff enter when registering an admin account.
ADMIN_VERIFICATION_CODE=ADMIN-VERIFY-2026

# One-tap demo accounts on the sign-in screen. On by default outside production.
ENABLE_DEMO_LOGIN=

# --- Single sign-on (leave blank to hide the buttons) ---
# Google: OAuth client IDs from Google Cloud Console. Comma-separate multiple web IDs.
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Apple: Services ID (web) and/or the iOS bundle ID.
APPLE_SERVICE_ID=
APPLE_BUNDLE_ID=
APPLE_REDIRECT_URI=

# Optional: Gemini Vision for OCR and visual checks in the certificate scanner.
GEMINI_API_KEY=
